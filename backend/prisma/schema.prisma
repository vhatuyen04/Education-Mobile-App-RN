generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RankField {
  Sport
  Academy
  Entertainment
}

enum SmartGoalProofStatus {
  PENDING_UPLOAD
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum GoalFailedReason {
  EXPIRED
  GAVE_UP
}

enum GoalRequirementSource {
  USER
  AI
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  name               String?
  refreshTokenHash   String?
  sportScore         Int?     @default(0)
  academyScore       Int?     @default(0)
  entertainmentScore Int?     @default(0)
  xp                 Int      @default(0)
  role               UserRole @default(USER)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  goals            Goal[]
  events           Event[]
  smartGoalProofAttempts SmartGoalProofAttempt[]
  scoreHistoryPoints     ScoreHistoryPoint[]
  notifications         UserNotification[]
}

model ScoreHistoryPoint {
  id     String   @id @default(cuid())
  userId String
  at     DateTime
  score  Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, at])
}

model LeaderboardTop {
  field     RankField @id
  userId    String?
  userName  String?
  points    Int       @default(0)
  updatedAt DateTime  @updatedAt
}

model Goal {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  requirement String?
  requirementSource GoalRequirementSource @default(USER)
  rankField   RankField?
  progressPct Int      @default(0)
  dueAt       DateTime?
  completed   Boolean  @default(false)
  difficultyScore      Int?
  difficultyConfidence Float?
  difficultyReason     String?
  pointsAwarded        Int      @default(1)
  xpAwarded            Int      @default(50)
  deletedAt   DateTime?
  failedAt    DateTime?
  failedReason GoalFailedReason?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps GoalStep[]
  proofAttempts SmartGoalProofAttempt[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, completed, dueAt])
}

model SmartGoalProofAttempt {
  id              String             @id @default(uuid())
  userId          String
  goalId          String
  status          SmartGoalProofStatus @default(PENDING_UPLOAD)
  requirementText String?
  proofKey        String?
  proofUrl        String?
  aiFeedback      String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([goalId])
  @@index([status])
}

model GoalStep {
  id        String   @id @default(uuid())
  goalId    String
  text      String
  order     Int      @default(0)
  dueAt     DateTime?
  repeat    String?
  repeatDay Int?
  repeatMonth Int?
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goal        Goal                 @relation(fields: [goalId], references: [id], onDelete: Cascade)
  completions GoalStepCompletion[]

  @@index([goalId])
  @@index([goalId, order])
  @@index([dueAt])
  @@index([repeat])
  @@index([repeat, repeatDay])
}

model GoalStepCompletion {
  id        String   @id @default(uuid())
  stepId    String
  date      DateTime
  createdAt DateTime @default(now())

  step GoalStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([stepId, date])
  @@index([date])
  @@index([stepId])
}

model AppSetting {
  key       String   @id
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserNotification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  data      Json?
  createdAt DateTime @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}

model Event {
  id            String   @id @default(uuid())
  userId        String
  title         String
  startAt       DateTime
  endAt         DateTime?
  repeat        String?
  seriesId      String?
  seriesStartAt DateTime?
  seriesEndAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, startAt])
  @@index([userId, seriesId])
}
