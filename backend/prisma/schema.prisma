generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RankField {
  Sport
  Academy
  Entertainment
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  name             String?
  score            Int      @default(0)
  sportScore        Int      @default(0)
  academyScore      Int      @default(0)
  entertainmentScore Int     @default(0)
  passwordHash     String
  refreshTokenHash String?
  goals            Goal[]
  events           Event[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model LeaderboardTop {
  field     RankField @id
  userId    String?
  userName  String?
  points    Int       @default(0)
  updatedAt DateTime  @updatedAt
}

model Goal {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  rankField   RankField?
  progressPct Int      @default(0)
  dueAt       DateTime?
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps GoalStep[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, completed, dueAt])
}

model GoalStep {
  id        String   @id @default(uuid())
  goalId    String
  text      String
  order     Int      @default(0)
  dueAt     DateTime?
  repeat    String?
  repeatDay Int?
  repeatMonth Int?
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goal        Goal                 @relation(fields: [goalId], references: [id], onDelete: Cascade)
  completions GoalStepCompletion[]

  @@index([goalId])
  @@index([goalId, order])
  @@index([dueAt])
  @@index([repeat])
  @@index([repeat, repeatDay])
}

model GoalStepCompletion {
  id        String   @id @default(uuid())
  stepId    String
  date      DateTime
  createdAt DateTime @default(now())

  step GoalStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([stepId, date])
  @@index([date])
  @@index([stepId])
}

model Event {
  id            String   @id @default(uuid())
  userId        String
  title         String
  startAt       DateTime
  endAt         DateTime?
  repeat        String?
  seriesId      String?
  seriesStartAt DateTime?
  seriesEndAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, startAt])
  @@index([userId, seriesId])
}
